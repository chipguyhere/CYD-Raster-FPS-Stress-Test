# ESP Launchpad (minimal) configuration for the CYD Raster FPS Stress Test,
# generated by release/build.sh from release/launchpad.toml.in.  Open it with
# chipguyhere's launchpad (it asks before flashing, honors erase_all, and with
# chip = "auto" picks the build for the connected chip):
#   https://chipguyhere.github.io/esp-launchpad/minimal-launchpad/?flashConfigURL=<this file's raw URL>
# Every URL here must send CORS headers: raw.githubusercontent.com does,
# GitHub release downloads don't.
esp_toml_version = 1.0
supported_apps = ["CYD Raster FPS Stress Test"]
multipart = true
chip = "auto"

["CYD Raster FPS Stress Test"]
readme.text = "https://raw.githubusercontent.com/chipguyhere/CYD-Raster-FPS-Stress-Test/main/README.md"
console_baudrate = 115200
# Write only these four parts: NVS (0x9000) is kept, so touch calibration and
# the demo's saved results survive.
erase_all = false
# The RasterBouncingBalls example, @VERSION@: bootloader, partition table,
# otadata, app.  The bootloader's address differs by chip.
image.esp32.parts = [
  "https://raw.githubusercontent.com/chipguyhere/CYD-Raster-FPS-Stress-Test/main/web-install/esp32/bootloader.bin",
  "https://raw.githubusercontent.com/chipguyhere/CYD-Raster-FPS-Stress-Test/main/web-install/esp32/partitions.bin",
  "https://raw.githubusercontent.com/chipguyhere/CYD-Raster-FPS-Stress-Test/main/web-install/esp32/boot_app0.bin",
  "https://raw.githubusercontent.com/chipguyhere/CYD-Raster-FPS-Stress-Test/main/web-install/esp32/app.bin",
]
image.esp32.addresses = ["0x1000", "0x8000", "0xe000", "0x10000"]
image.esp32c5.parts = [
  "https://raw.githubusercontent.com/chipguyhere/CYD-Raster-FPS-Stress-Test/main/web-install/esp32c5/bootloader.bin",
  "https://raw.githubusercontent.com/chipguyhere/CYD-Raster-FPS-Stress-Test/main/web-install/esp32c5/partitions.bin",
  "https://raw.githubusercontent.com/chipguyhere/CYD-Raster-FPS-Stress-Test/main/web-install/esp32c5/boot_app0.bin",
  "https://raw.githubusercontent.com/chipguyhere/CYD-Raster-FPS-Stress-Test/main/web-install/esp32c5/app.bin",
]
image.esp32c5.addresses = ["0x2000", "0x8000", "0xe000", "0x10000"]
image.esp32s3.parts = [
  "https://raw.githubusercontent.com/chipguyhere/CYD-Raster-FPS-Stress-Test/main/web-install/esp32s3/bootloader.bin",
  "https://raw.githubusercontent.com/chipguyhere/CYD-Raster-FPS-Stress-Test/main/web-install/esp32s3/partitions.bin",
  "https://raw.githubusercontent.com/chipguyhere/CYD-Raster-FPS-Stress-Test/main/web-install/esp32s3/boot_app0.bin",
  "https://raw.githubusercontent.com/chipguyhere/CYD-Raster-FPS-Stress-Test/main/web-install/esp32s3/app.bin",
]
image.esp32s3.addresses = ["0x0", "0x8000", "0xe000", "0x10000"]
